# Server port
PORT=4000
NODE_ENV=development

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/interview_prep_kit

# Session signing secret — set a long random string in any real deployment
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Origin allowed to call this API with credentials (your deployed frontend URL locally http://localhost:3000)
CORS_ORIGIN=http://localhost:3000

# LLM provider — any OpenAI-chat-completions-compatible endpoint with a free tier works unmodified.
# Defaults below target Groq (https://console.groq.com) — free tier, no code changes needed to switch.
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=https://api.groq.com/openai/v1
